<% @reviews.each do |review| %>
    <div class ="bg-white shadow-md rounded-lg p-6 mb-4 border border-slate-200">

       
        <%= link_to "#{review.title} / #{review.author}", "#", class: "text-xl text-blue-600 hover:text-blue-800 transition" %>
        <p class="text-lg text-gray-400"><%= review.comment %></p>

        <div class="flex justify-between">
            <span class="text-gray-600 mb-2">ジャンル: <%= review.genre %></span>
   
            <span class="text-gray-500 text-sm ">投稿者: <%= review.user.name %></span>
        </div>
       
    </div>
<% end %>
