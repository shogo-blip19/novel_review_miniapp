<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      
      <!-- ロゴ領域 -->
      <div class="flex-shrink-0 flex items-center">
        <%= link_to root_path, class: "text-xl font-bold text-gray-900 flex items-center gap-2" do %>
          <!-- アイコン（SVG）またはロゴ画像 -->
          <span class="bg-blue-600 text-white p-1.5 rounded-lg text-sm">App</span>
          <span>小説を探そう</span>
        <% end %>
      </div>

      <!-- PC用ナビゲーションリンク（画面幅 md 以上で表示） -->
      <nav class="hidden md:flex space-x-8">
        <%= link_to "レビュー一覧", "#", class: "text-gray-600 hover:text-gray-900 font-medium transition" %>
        <%= link_to "レビュー投稿", new_review_path, class: "text-gray-600 hover:text-gray-900 font-medium transition" %>
      </nav>

      <!-- PC用右側ボタン（画面幅 md 以上で表示） -->


      <div class="hidden md:flex items-center space-x-4">
        <% if logged_in? %>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "text-gray-600 hover:text-gray-900 font-medium px-3 py-2 transition" %>
        <% else %>
        <%= link_to "ログイン",login_path, class: "text-gray-600 hover:text-gray-900 font-medium px-3 py-2 transition" %>
        <% end %>
        <%= link_to "新規登録",new_user_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-lg transition shadow-sm" %>
      </div>

      <!-- スマホ用ハンバーガーボタン（画面幅 md 未満で表示） -->
      <div class="md:hidden flex items-center">
        <button type="button" class="text-gray-500 hover:text-gray-700 p-2 rounded-md focus:outline-none" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

    </div>　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　
  </div>

  <!-- スマホ用アコーディオンメニュー（初期状態は hidden で非表示） -->
  <div class="hidden md:hidden border-t border-gray-200 bg-gray-50 px-4 pt-2 pb-4 space-y-1" id="mobile-menu">
    <%= link_to "レビュー一覧", "#", class: "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100" %>
    <%= link_to "レビュー投稿", new_review_path, class: "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100" %>
    <div class="pt-2 border-t border-gray-200 flex flex-col space-y-2">
     <% if logged_in? %>
        <%= button_to "ログアウト", logout_path, method: :delete, class: "text-gray-600 hover:text-gray-900 font-medium px-3 py-2 transition" %>
        <% else %>
        <%= link_to "ログイン",login_path, class: "text-gray-600 hover:text-gray-900 font-medium px-3 py-2 transition" %>
     <% end %>
      <%= link_to "新規登録", new_user_path, class: "block text-center bg-blue-600 text-white px-3 py-2 rounded-md text-base font-medium" %>
    </div>
  </div>
</header>