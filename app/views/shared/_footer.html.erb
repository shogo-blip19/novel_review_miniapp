<footer class="bg-gray-900 text-gray-400 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- スマホでは1列、PC（md）では4列のグリッド構造 -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- 1列目：サービス紹介 -->
      <div class="space-y-4">
        <span class="text-xl font-bold text-white">サービス名</span>
        <p class="text-sm leading-relaxed">
          ここにアプリの概要文やキャッチコピーが入ります。使いやすさを追求したWebアプリケーションです。
        </p>
      </div>

      <!-- 2列目：リンク集1 -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">サービス</h3>
        <ul class="space-y-2 text-sm">
          <li><%= link_to "機能一覧", "#", class: "hover:text-white transition" %></li>
          <li><%= link_to "料金プラン", "#", class: "hover:text-white transition" %></li>
          <li><%= link_to "アップデート情報", "#", class: "hover:text-white transition" %></li>
        </ul>
      </div>

      <!-- 3列目：リンク集2 -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">サポート・規約</h3>
        <ul class="space-y-2 text-sm">
          <li><%= link_to "ヘルプセンター", "#", class: "hover:text-white transition" %></li>
          <li><%= link_to "利用規約", "#", class: "hover:text-white transition" %></li>
          <li><%= link_to "プライバシーポリシー", "#", class: "hover:text-white transition" %></li>
        </ul>
      </div>

      <!-- 4列目：お問い合わせ / SNSリンクなど -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">お問い合わせ</h3>
        <p class="text-sm mb-2">ご質問・ご要望はこちらから</p>
        <%= link_to "お問い合わせフォーム", "#", class: "inline-block bg-gray-800 hover:bg-gray-700 text-white text-sm font-medium py-2 px-4 rounded transition" %>
      </div>

    </div>

    <!-- 最下部：コピーライト -->
    <div class="mt-12 pt-8 border-t border-gray-800 text-center text-xs text-gray-500">
      &copy; <%= Time.current.year %> サービス名 Inc. All rights reserved.
    </div>
  </div>
</footer>