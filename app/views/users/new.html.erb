<%# 外枠：PC(lg:)では最大幅をxl(56rem/896px)まで広げる %>
<div class="min-h-screen bg-slate-50 flex flex-col  py-12 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto w-full max-w-md max-w-2xl">
    <h2 class="text-center text-3xl font-extrabold text-slate-900">
      新規ユーザー登録
    </h2>
    <p class="mt-2 text-center text-sm text-slate-600">
      アカウントを作成してサービスを開始しましょう
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md lg:max-w-2xl">
    <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-slate-100">
      
      <%= form_with model: @user, local: true, class: "space-y-6" do |f| %>
        
        <%# エラーメッセージ表示エリア %>
        <% if @user&.errors&.any? %>
          <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-4 rounded-r-md">
            <div class="flex">
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@user.errors.count, "件のエラー") %>が発生しました
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc pl-5 space-y-1">
                    <% @user.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <%# PCサイズ(md:)のときだけ2列（grid-cols-2）にするコンテナ %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Name -->
          <div>
            <%= f.label :name, "ユーザー名", class: "block text-sm font-medium text-slate-700" %>
            <div class="mt-1">
              <%= f.text_field :name, 
                  required: true, 
                  autocomplete: "name", 
                  placeholder: "山田 太郎",
                  class: "w-full px-3 py-2 border border-slate-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
            </div>
          </div>

          <!-- Email -->
          <div>
            <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-slate-700" %>
            <div class="mt-1">
              <%= f.email_field :email, 
                  required: true, 
                  autocomplete: "email", 
                  placeholder: "example@email.com",
                  class: "w-full px-3 py-2 border border-slate-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
            </div>
          </div>

          <!-- Password -->
          <div>
            <%= f.label :password, "パスワード", class: "block text-sm font-medium text-slate-700" %>
            <div class="mt-1">
              <%= f.password_field :password, 
                  required: true, 
                  autocomplete: "new-password", 
                  placeholder: "8文字以上",
                  class: "w-full px-3 py-2 border border-slate-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
            </div>
          </div>

          <!-- Password Confirmation -->
          <div>
            <%= f.label :password_confirmation, "パスワード（確認用）", class: "block text-sm font-medium text-slate-700" %>
            <div class="mt-1">
              <%= f.password_field :password_confirmation, 
                  required: true, 
                  autocomplete: "new-password", 
                  placeholder: "もう一度入力してください",
                  class: "w-full px-3 py-2 border border-slate-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
            </div>
          </div>

        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <%= f.submit "アカウント登録", 
              class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-150 cursor-pointer" %>
        </div>

      <% end %>

    </div>
  </div>
</div>